# ====================================================================
# Caddy 설정 - jeonghoonlee.com 정적 사이트 서빙
# --------------------------------------------------------------------
# Let's Encrypt 인증서 발급/자동 갱신은 Caddy의 "기본 동작"이다.
# 도메인을 명시하고 80/443 포트가 외부에 열려 있으면,
# Caddy가 자동으로 인증서를 발급하고 만료 전 자동 갱신한다.
# 따라서 인증서 관련 별도 스크립트나 설정은 필요하지 않다.
# ====================================================================

jeonghoonlee.com {
    # 정적 파일이 위치한 컨테이너 내부 경로 (docker-compose 에서 마운트)
    root * /srv/webapp

    # SPA 라우팅 대응: 실제 파일이 없으면 index.html 로 폴백
    try_files {path} /index.html

    # 정적 파일 서버 활성화
    file_server

    # 텍스트 자산 gzip/zstd 압축 (전송량 절감)
    encode gzip zstd
}
